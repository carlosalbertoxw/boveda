# Formato comun a todo el repositorio. Android Studio e IntelliJ lo aplican al
# escribir y al reformatear (Ctrl+Alt+L); detekt revisa el resto en el CI.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL

[*.{yml,yaml,json,toml,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
