## Plantilla. Copiar como keystore.properties y rellenar con los datos reales.
## keystore.properties y *.jks estan en .gitignore: nunca se versionan.

## Ruta al keystore, relativa a la raiz del proyecto (o absoluta).
storeFile=boveda-release.jks

## Contrasena del keystore.
storePassword=

## Alias de la clave dentro del keystore.
keyAlias=boveda

## Contrasena de la clave. Con keytool -genkeypair suele ser la misma que
## storePassword salvo que se indique otra con -keypass.
keyPassword=
