# Un solo .gitignore para todo el repositorio: las tres builds (boveda-android,
# boveda-desktop y boveda-nucleo) generan lo mismo, y los patrones sin barra
# inicial valen en cualquier carpeta.

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# IDE: abrir la raiz del repositorio en Android Studio o IntelliJ tambien
# genera configuracion local que no debe versionarse.
.idea/
*.iml
.vscode/

# Gradle y Kotlin.
.gradle/
.kotlin/
build/
local.properties

# Firma: nunca al repositorio, este donde este.
keystore.properties
*.jks
*.keystore

# Bovedas de prueba y respaldos exportados: van cifrados, pero no son codigo.
datos-prueba/
